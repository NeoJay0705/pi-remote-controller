{
  "name": "pi-remote-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "prw": "dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "server:dev": "tsx src/server/main.ts",
    "start": "node dist/server/main.js",
    "tui": "node dist/cli/main.js",
    "test": "node scripts/test-env.mjs vitest",
    "test:e2e": "node scripts/test-env.mjs playwright",
    "typecheck": "tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src test scripts",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.server.json tsconfig.web.json vite.config.ts eslint.config.mjs vitest.config.ts playwright.config.ts README.md scripts test/helpers src/shared src/server src/cli src/web test/unit test/integration test/e2e test/fixtures config/example.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && vite build",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "fastify": "^5.6.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.10",
    "vitest": "4.1.11"
  }
}
